# Copy to .env and fill in. Never commit .env.
# Values come from the GitHub App settings (see docs/github-app.md).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# The app's own credentials, for webhooks and the PR reviewer. Leave empty to turn the webhook off.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# Classroom mode: teacher GitHub logins (comma-separated) and the secret for the weekly summary endpoint.
CLASSROOM_TEACHERS=
CLASSROOM_SUMMARY_SECRET=
# Anthropic API key for the LLM-written student texts (docs/custo-por-aluno.md).
# Leave empty to use the default texts.
ANTHROPIC_API_KEY=

# Written by `neon env pull` (see docs/deploy.md). Leave them out, not empty, to
# use the local PostgreSQL from compose.yaml.
# DATABASE_URL=
# DATABASE_URL_UNPOOLED=
# NEON_BRANCH=
