# Copy to .env and fill in. Never commit .env.
# Values come from the GitHub App settings (see docs/github-app.md).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Written by `neon env pull` (see docs/deploy.md). Leave them out, not empty, to
# use the local PostgreSQL from compose.yaml.
# DATABASE_URL=
# DATABASE_URL_UNPOOLED=
# NEON_BRANCH=
