# Copy to .env and fill in. Never commit .env.
# Values come from the GitHub App settings (see docs/github-app.md).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Anthropic API key for the LLM-written student texts (docs/custo-por-aluno.md).
# Leave empty to use the default texts.
ANTHROPIC_API_KEY=

# Written by `neon env pull` (see docs/deploy.md). Leave them out, not empty, to
# use the local PostgreSQL from compose.yaml.
# DATABASE_URL=
# DATABASE_URL_UNPOOLED=
# NEON_BRANCH=
